<?xml version="1.0" encoding="utf-8"?>
<!--
  SellerChat manifest.

  PERMISSIONS: this app declares ZERO permission elements and requests
  zero runtime permissions. That is a hard product requirement, not an
  oversight. The only network user is the AdMob SDK, which brings its own
  INTERNET permission via manifest merger from the play-services-ads library
  (standard for every ad-supported app; the app itself declares none).

  The <queries> block below is package VISIBILITY, not a permission: on
  Android 11+ it lets us ask "is WhatsApp / WhatsApp Business installed?"
  and aim an intent at exactly those two packages.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <queries>
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
    </queries>

    <application
        android:name=".SellerChatApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SellerChat">

        <!-- AdMob app ID. This is Google's public SAMPLE app ID.
             TODO(FAHAD): replace with your real AdMob App ID before release. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Growth path: another app shares text containing a phone number
                 ("Share → SellerChat") and the number lands pre-filled on Home. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Used only to share the generated QR PNG from the app cache. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
